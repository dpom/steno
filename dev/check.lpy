(ns dev.check
  (:require
   [basilisp.io :as bio]
   [dev.show :as show]
   [steno.corpus :as corpus]
   [steno.utils :as utl])
  (:import
   os
   pathlib))

(def corpus-dir "/home/dan/pers/projects/steno/resources/corpus")

(defn check
  [dir pos]
  (let [p (bio/path corpus-dir dir)
        f     (-> p
                  os/listdir
                  sort
                  (nth pos))]
    (->> f
         (bio/path p)
         utl/load-edn
         show/show-lsign)))

(defn get-letter-dimensions
  [corpus]
  (let [width (map :width corpus)
        height (map :height corpus)]
    {:min-width (apply min width)
     :max-width (apply max width)
     :min-height (apply min height)
     :max-height (apply max height)}))

(defn letter-dim
  []
  (mapv (fn [letter]
          (let [corpus (->> letter
                            (bio/path corpus-dir)
                            corpus/read-corpus)]
            (when (seq corpus)
              (assoc (get-letter-dimensions corpus) :letter letter))))
        (concat tra/type-0-letters tra/type-1-letters)))
