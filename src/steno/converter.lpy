(ns steno.converter
  "Convert images in numeric sequences"
  (:require
   [basilisp.set :as set]
   [steno.spec :as spec]
   [steno.utils :as utl])
  (:import
   math
   [numpy :as np]))

(def type-0-min-len
  "Minimum len of a type 0 lseq."
  20)

(def type-1-min-len
  "Minimum len of a type 1 lseq."
  10)

(def neighbor-factor
  "Factor that determines how close two cells must be to be neighbors."
  10)

(defn get-start-point
  "Get the start point of the glyph: the topmost degree-1 endpoint, or when the
   glyph has no endpoints (a closed loop) the topmost-leftmost foreground cell."
  [image]
  (let [cells (utl/endpoint-coords image)]
    (if (seq cells)
      (first (sort-by (juxt second first) cells))
      (let [mask (np/greater image 0)
            [rs cs] (np/where mask)]
        (->> (map (fn [r c] [(int r) (int c)]) rs cs)
             (sort-by (juxt first second))
             first)))))

(defn get-cell-value
  "Get cell value. If row or column index is wrong return 0."
  ([mat [row column]]
   (let [[h w] (.-shape mat)]
     (try
       (if (or (neg? row) (neg? column) (>= row h) (>= column w))
         0
         (int (aget mat row column)))
       (catch Exception _e
         0))))
  ([mat [row column] [dr dc]]
   (get-cell-value mat [(+ row dr) (+ column dc)])))

(defn get-cnum-and-neighbors
  "Get all neighbors with 1 and the cell cnum."
  [mat [row column :as cell]]
  (reduce (fn [[neighbors num] [dr dc :as dir]]
            (let [v (get-cell-value mat cell dir)]
              [(if (zero? v)
                 neighbors
                 (conj neighbors [(+ row dr) (+ column dc)]))
               (+ (* num 2) v)]))
          [#{} 0]
          spec/all-directions))

(defn get-liniar-sequence
  "Return a liniar numeric sequence.

   Params:
   - mat : the word matrix
   - state: (map) state of the extracting process
     - start-cell : [row column]
     - prev-cells : (set) previous cells with value 1 processed

   Returns: state map updated + numseq"
  [mat {:keys [start-cell prev-cells]}]
  (loop [start start-cell
         prev prev-cells
         line []]
    (let [[neighbors val] (get-cnum-and-neighbors mat start)
          new-neighbors (set/difference neighbors prev)
          new-line (conj line (conj start val))
          new-prev (conj prev start)]
      (if-not (= (count new-neighbors) 1)
        {:start-cells new-neighbors
         :prev-cells new-prev
         :line new-line}
        (recur (first new-neighbors) new-prev new-line)))))

(defn- parallel-lineseq?
  "True if line sequence is a loop"
  [lseq]
  (= (utl/nested-levels lseq) 3))

(defn- parallel-to-liniar
  "Transform a one line parallel sequence into a liniar sequence"
  [line-seq]
  (let [lseq (filterv seq line-seq)]
    (if (and (parallel-lineseq? lseq) (= (count lseq) 1))
      (first lseq)
      lseq)))

(defn get-parallel-sequence
  "Return a parallel numeric sequence. The parallel numeric sequence contains usual 2 liniar sequences forming a loop.

   Params:
   - mat : the word matrix
   - status: (map) status of the extracting process
      - start-cells : (set) cells to process
      - prev-cells : (set) previous cells with value 1

   Returns: state map updated + :line (the line sequence)  "
  [mat {:keys [start-cells prev-cells]}]
  (let [{:keys [line] :as state} (reduce (fn [acc cell]
                                           (if (get (:prev-cells acc) cell)
                                             acc
                                             (let [new-seq (get-liniar-sequence mat
                                                                                (assoc acc
                                                                                       :line []
                                                                                       :start-cells #{}
                                                                                       :start-cell cell))
                                                   new-acc  {:prev-cells (:prev-cells new-seq)
                                                             :line (conj (:line acc) (:line new-seq))
                                                             :start-cells (into (:start-cells acc) (:start-cells new-seq))}]
                                               new-acc)))
                                         {:prev-cells prev-cells
                                          :line []
                                          :start-cells #{}}
                                         start-cells)]
    (assoc state :line (parallel-to-liniar line))))

(defn dist
  [[x1 y1 _] [x2 y2 _]]
  (math/dist [x1 y1] [x2 y2]))

(defn neighbors?
  "True if the cells are adiacent"
  [p1 p2]
  (< (dist p1 p2) neighbor-factor))

(defn small-type-1-lineseq?
  "True if lineseq size is small (5-)"
  [lseq]
  (let [size (count lseq)]
    (and (pos? size) (< size type-1-min-len))))

(defn small-type-0-lineseq?
  "True if lineseq size is smaller than min type 0."
  [lseq]
  (let [size (count lseq)]
    (and (pos? size) (< size type-0-min-len))))

(defn get-ltype
  "Returns the line sequence type: loop (0) or liniar (1)"
  [lseq]
  (if (and (not (small-type-0-lineseq? lseq)) (neighbors? (first lseq) (last lseq))) 0 1))

(defn- flatten-lineseqs
  "Flatten nested parallel traces into a flat vector of line sequences."
  [lineseqs]
  (reduce (fn [acc lseq]
            (if (> (utl/nested-levels lseq) 2)
              (into acc (flatten-lineseqs lseq))
              (if (seq lseq) (conj acc lseq) acc)))
          []
          lineseqs))

(defn- junction-points
  "Endpoint cells shared by more than two traces in the original extraction."
  [lineseqs]
  (let [endpoints (mapcat (fn [lseq] (distinct [(first lseq) (last lseq)]))
                          lineseqs)]
    (->> endpoints
         (filter (fn [point]
                   (> (count (filter (fn [lseq]
                                       (or (neighbors? point (first lseq))
                                           (neighbors? point (last lseq))))
                                     lineseqs))
                      2)))
         set)))

(defn- junction-point?
  "True if POINT lies on a junction found in the original extraction."
  [junctions point]
  (some (fn [junction] (neighbors? point junction)) junctions))

(defn- junction-free?
  "True if neither join point lies on a junction."
  [junctions p1 p2]
  (and (not (junction-point? junctions p1))
       (not (junction-point? junctions p2))))

(defn- noise-lineseq?
  "True for a tiny fragment that sits on a junction."
  [junctions lseq]
  (and (small-type-1-lineseq? lseq)
       (or (junction-point? junctions (first lseq))
           (junction-point? junctions (last lseq)))))

(defn- join-loop
  "Join two line sequences into one closed line when both endpoint pairs are
   adjacent and neither join point is a junction. Return nil when the sequences
   do not form a loop."
  [junctions lseq1 lseq2]
  (when (and (seq lseq1) (seq lseq2))
    (cond
      (and (neighbors? (first lseq1) (first lseq2))
           (neighbors? (last lseq1) (last lseq2))
           (junction-free? junctions (first lseq1) (last lseq1)))
      (into lseq1 (rseq lseq2))

      (and (neighbors? (first lseq1) (last lseq2))
           (neighbors? (last lseq1) (first lseq2))
           (junction-free? junctions (first lseq1) (last lseq1)))
      (into lseq1 lseq2))))

(defn- join-linear
  "Join two line sequences end-to-end when any endpoint pair is adjacent and
   the join point is not a junction. Return nil when the sequences are not
   adjacent."
  [junctions lseq1 lseq2]
  (when (and (seq lseq1) (seq lseq2))
    (cond
      (and (neighbors? (last lseq1) (first lseq2))
           (junction-free? junctions (last lseq1) (first lseq2)))
      (into lseq1 lseq2)

      (and (neighbors? (last lseq1) (last lseq2))
           (junction-free? junctions (last lseq1) (last lseq2)))
      (into lseq1 (rseq lseq2))

      (and (neighbors? (first lseq1) (first lseq2))
           (junction-free? junctions (first lseq1) (first lseq2)))
      (into (vec (rseq lseq1)) lseq2)

      (and (neighbors? (first lseq1) (last lseq2))
           (junction-free? junctions (first lseq1) (last lseq2)))
      (into lseq2 lseq1))))

(defn- flush-pending
  "Append PENDING to OUT unless it is noise sitting on a junction."
  [junctions pending out]
  (if (or (nil? pending) (noise-lineseq? junctions pending))
    out
    (conj out pending)))

(defn- normalize-once
  "Join adjacent line sequences in one left-to-right pass."
  [junctions lineseqs]
  (let [{:keys [pending out]}
        (reduce
         (fn [{:keys [pending out]} lseq]
           (if-not pending
             {:pending lseq :out out}
             (if-let [joined (join-loop junctions pending lseq)]
               {:pending nil :out (conj out joined)}
               (if-let [joined (join-linear junctions pending lseq)]
                 {:pending joined :out out}
                 {:pending lseq :out (flush-pending junctions pending out)}))))
         {:pending nil :out []}
         lineseqs)]
    (flush-pending junctions pending out)))

(defn normalize-lineseqs
  "Flatten nested line sequences and join adjacent traces until stable."
  [lineseqs]
  (let [lines (flatten-lineseqs lineseqs)
        junctions (junction-points lines)]
    (loop [lines lines]
      (let [next-lines (normalize-once junctions lines)]
        (if (< (count next-lines) (count lines))
          (recur next-lines)
          next-lines)))))

(defn- get-loop-start
  [line]
  (reduce (fn [{:keys [min-x min-y] :as res} [pos [x y _]]]
            (if (or (< x min-x) (and (= x min-x) (< y min-y)))
              {:min-x x :min-y y :min-pos pos}
              res))
          {:min-x (first (first line))
           :min-y (second (first line))
           :min-pos 0}
          (map-indexed list (rest line))))

(defn- normalize-loop
  [line]
  (let [pos (:min-pos (get-loop-start line))]
    (into (subvec line pos) (subvec line 0 pos))))

(defn compare-cell
  "Compare CELLs with the format [x y ...]."
  [cell1 cell2]
  (compare (+ (first cell1) (second cell1))
           (+ (first cell2) (second cell2))))

(defn- normalize-liniar
  [line]
  (if (compare-cell (first line) (last line))
    (reverse line)
    line))

(defn image-to-lineseq
  "Convert a gliph image in a vector of line sequences."
  [mat]
  (if-let [start (get-start-point mat)]
    (loop [state {:start-cells #{start}
                  :prev-cells #{}
                  :line []}
           acc []]
      (let [new-state (if (= (count (:start-cells state)) 1)
                        (get-liniar-sequence mat (assoc state :start-cell (first (:start-cells state))))
                        (get-parallel-sequence mat state))
            new-acc (conj acc (:line new-state))]
        (if (empty? (:start-cells new-state))
          (filterv seq new-acc)
          (recur new-state new-acc))))
    []))

(defn- lineseq-to-lsign
  "Convert a LINESEQ in a lsign (a map with lineseq and ltype keys)."
  [lineseq]
  (let [ltype (get-ltype lineseq)
        ls (if (zero? ltype) (normalize-loop lineseq) (normalize-liniar lineseq))]
    {:ltype ltype
     :lineseq ls}))

(defn lineseqs-to-wsign
  "Convert a sequence of LINESEQ in a wsign (a sequence of lsign)."
  [lineseqs]
  (->> lineseqs
       normalize-lineseqs
       (mapv lineseq-to-lsign)))

(defn- normalize1-lsign
  "LSIGN lineseq should start with the cell closest to the origin."
  [{:keys [lineseq] :as lsign}]
  (if (= 1 (compare-cell (first lineseq)  (last lineseq)))
    (assoc lsign :lineseq (reverse lineseq))
    lsign))

(defn normalize2-lsign
  "Shift LSIGN lineseq to axe origin."
  [{:keys [lineseq] :as lsign}]
  (let [x-min (apply min (map first lineseq))
        y-min (apply min (map second lineseq))
        new-lineseq (mapv (fn [[x y n]] [(- x x-min) (- y y-min) n]) lineseq)]
    (assoc lsign
           :lineseq new-lineseq
           :width (apply max (map second new-lineseq))
           :height (apply max (map first new-lineseq)))))

;; module entry points

(defn image-to-wsign
  "Convert a gliph image in a wsign."
  [image]
  (->> image
       image-to-lineseq
       lineseqs-to-wsign
       (map normalize1-lsign)
       (sort-by #(first (:lineseq %)) compare-cell)))

