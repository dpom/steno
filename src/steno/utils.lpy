(ns steno.utils
  (:require
   [basilisp.edn :as edn]
   [basilisp.io :as bio]
   [basilisp.pprint :as p]
   [basilisp.string :as str])
  (:import
   cv2
   [multiprocessing :refer [Process]]
   [numpy :as np]
   [os.path :as path]))

(defn start-proc
  "Start FUNC with ARG in a thread process and return its id."
  [func arg]
  (let [p (Process ** :target func :args [arg])]
    (.start p)
    p))

(defmacro mget
  "Get a slice of a matrix"
  [m r1 r2 c1 c2]
  `(aget ~m (python/tuple [(python/slice ~r1 ~r2) (python/slice ~c1 ~c2)])))

(defn print4tap
  "Print function for tap>, useful in REPL."
  [map]
  (p/print-table (keys map) [map]))

(defn bin-u8
  "Convert 0/255 skeleton as uint8 0/1."
  [img]
  (.astype (np/greater img 0) np/uint8))

(defn neighbor-counts
  "8-connected foreground neighbour count for every pixel. Outside the image is
   treated as background (zero-padded) so stroke endpoints on the image border
   are still detected as degree-1. The result keeps the input shape: caller
   coordinates (possibly on a 1px-padded glyph) stay aligned."
  [bin-img]
  (let [kernel (np/ones [3 3] np/uint8)
        padded (cv2/copyMakeBorder bin-img 1 1 1 1 cv2/BORDER_CONSTANT 0)
        summed (cv2/filter2D padded -1 kernel)
        cropped (aget summed (python/tuple [(python/slice 1 -1) (python/slice 1 -1)]))]
    (np/subtract cropped bin-img)))

(defn endpoint-coords
  "Coordinates of degree-1 foreground pixels (dangling ends)."
  [bin-img]
  (let [nbr (neighbor-counts bin-img)
        cond (np/logical_and (np/equal bin-img 1) (np/equal nbr 1))
        [rs cs] (np/where cond)]
    (map (fn [r c] [(int r) (int c)]) rs cs)))

(defn nested-levels
  "Return the depth level of a nested Vector."
  [v]
  (if (vector? v)
    (if (empty? v)
      1
      (let [max-nested (apply max (map nested-levels v))]
        (inc max-nested)))
    0))

(defn cells-to-matrix
  "Transform a sequence of CELLS ([x y]) into a matrix of dimensions SIZE ([x y])"
  [size cells]
  (let [mat (np/zeros size ** :dtype "int")]
    (doseq [[x y] cells]
      (aset mat x y 1))
    mat))

(defn lineseq-to-matrix
  [lineseq]
  (let [x-max (inc (apply max (map first lineseq)))
        y-max (inc (apply max (map second lineseq)))
        mat (np/zeros [x-max y-max] ** :dtype "uint8")]
    (doseq [[x y] lineseq]
      (aset mat x y 255))
    mat))

(defn map-glyph-matrix
  "Generic function that iterates through the MATRIX of glyphs
  and returns a new matrix applying function F to each glyph.
  F must be side-effect free and has 3 arguments: row index,
  column index and glyph"
  [matrix f]
  (map-indexed (fn [idx-row row]
                 (map-indexed (fn [idx-col glyph]
                                (f idx-row idx-col glyph))
                              row))
               matrix))

(defn load-edn
  "Load an entity from an edn file with FILENAME."
  [filename]
  (let [content (slurp filename :encoding "utf-8")]
    (edn/read-string content)))

(defn- make-key-comparator
  "Creează un comparator pentru ordonarea cheilor (cu suport pentru priorități)."
  [priority-keys]
  (let [priority-map (zipmap priority-keys (range))]
    (fn [k]
      [(get priority-map k 9999) (str k)])))

(defn- indent-str
  "Generează un string cu spații pentru nivelul curent de indentare."
  [level indent-size]
  (str/join "" (repeat (* level indent-size) " ")))

(defn data->pprint-edn-str
  "Transformă o structură într-un string EDN formatat frumos (pretty-printed).

   Opțiuni (opts):
   - :indent-size   numărul de spații per nivel de indentare (default: 2)
   - :priority-keys vector de chei care să apară primele în hărți"
  ([data]
   (data->pprint-edn-str data {}))
  ([data {:keys [indent-size priority-keys]
          :or {indent-size 2 priority-keys []}}]
   (let [key-rank (make-key-comparator priority-keys)]
     (letfn [(format-node [x level]
               (let [pad (indent-str level indent-size)
                     next-pad (indent-str (inc level) indent-size)]
                 (cond
                   ;; --- MAPS ---
                   (map? x)
                   (if (empty? x)
                     "{}"
                     (let [sorted-ks (sort-by key-rank (keys x))
                           entries (for [k sorted-ks]
                                     (str next-pad
                                          (pr-str k) " "
                                          (format-node (get x k) (inc level))))]
                       (str "{\n"
                            (str/join ",\n" entries) "\n"
                            pad "}")))

                   ;; --- VECTORS ---
                   (vector? x)
                   (if (empty? x)
                     "[]"
                     (let [items (for [item x]
                                   (str next-pad (format-node item (inc level))))]
                       (str "[\n"
                            (str/join "\n" items) "\n"
                            pad "]")))

                   ;; --- SETS ---
                   (set? x)
                   (if (empty? x)
                     "#{}"
                     (let [sorted-items (sort-by str x)
                           items (for [item sorted-items]
                                   (str next-pad (format-node item (inc level))))]
                       (str "#{\n"
                            (str/join "\n" items) "\n"
                            pad "}")))

                   ;; --- SCALARS / PRIMITIVES ---
                   :else
                   (pr-str x))))]
       (format-node data 0)))))

(defn save-pprint-edn
  "Salvează datele în EDN formatat frumos într-un fișier."
  [filename data & {:as opts}]
  (spit filename (data->pprint-edn-str data opts)))

(defn save-edn
  "Save an ENTITY in an edn file with FILENAME."
  [filename entity]
  (with-open [w (bio/writer filename)]
    (edn/write entity w)
    (.write w "\n")))

(defn get-filename
  "Extract the name of a file without extension from a full PATH."
  [path]
  (-> path
      (path/basename)
      (path/splitext)
      (first)))

(comment

  (add-tap (bound-fn* print4tap))

  (tap> {:a 2 :b 5})

  (nested-levels [1 2 3])               ; => 1
  (nested-levels [[1 2] 3])             ; => 2
  (nested-levels [[1 2] [3 [4 5]]])     ; => 3
  (nested-levels [[[1]] [[2]]])         ; => 3
  (nested-levels "not a vector")        ; => 0

  (def test (load-edn "resources/diff-references.edn"))

  (save-pprint-edn "test_pretty.edn" test
                   :indent-size 2
                   :priority-keys [:type-0 :type-1 :letter :min-len :max-len])

  ;;
  )
