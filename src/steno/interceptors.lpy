(ns steno.interceptors)

(defn skip
  "Skips the next interceptor in the pipeline queue."
  [ctx]
  (assoc ctx :queue []))

(defn- dispatch-error
  "Traverses the stack in reverse to find and execute an :error handler."
  [stack context ex]
  (if (seq stack)
    (let [interceptor (first stack)
          error-fn (:error interceptor)]
      (if error-fn
        (try
          (let [ctx-with-err (assoc context :exception ex)]
            (error-fn ctx-with-err))
          (catch Exception new-ex
            (dispatch-error (rest stack) context new-ex)))
        (dispatch-error (rest stack) context ex)))
    (throw ex)))

(defn execute
  "Executes a pipeline of interceptors with :enter and :error phases,
   supporting queue manipulation and skipping."
  [initial-context interceptors]
  (letfn [(step [ctx]
            (let [queue (:queue ctx)]
              (if (seq queue)
                (let [interceptor (first queue)
                      ;; Pop from queue, push to stack
                      next-ctx (-> ctx
                                   (update :queue rest)
                                   (update :stack conj interceptor))
                      enter-fn (:enter interceptor)]
                  (if enter-fn
                    (try
                      (let [result-ctx (enter-fn next-ctx)]
                        (step result-ctx))
                      (catch Exception e
                        (dispatch-error (:stack next-ctx) next-ctx e)))
                    (step next-ctx)))
                ctx)))]
    ;; Initialize context with execution queue and history stack
    (let [ctx (assoc initial-context :queue interceptors :stack [])
          final-ctx (step ctx)]
      ;; Clean up internal framework keys before returning the final context
      (dissoc final-ctx :queue :stack))))

(comment

;; Example Pipeline

  (def logger
    {:enter (fn [ctx]
              (println "  -> Executing: Logger")
              ctx)})

  (def cache-lookup
    {:enter (fn [ctx]
              (println "  -> Executing: Cache Lookup (Found cached response!)")
            ;; Short-circuit and skip all downstream handlers/interceptors
              (-> ctx
                  (assoc :response {:status 200 :body "Cached Data"})
                  skip))})

  (def heavy-database-handler
    {:enter (fn [ctx]
              (println "  -> Executing: Database Handler (You should NOT see this!)")
              (assoc ctx :response {:status 200 :body "Fresh Data"}))})

  (def pipeline1 [logger cache-lookup heavy-database-handler])

  (execute {} pipeline1)
  ;; => {:response {:status 200, :body "Cached Data"}}

;;
  )
