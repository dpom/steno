(ns steno.checker
  "Interactive translator-proposal checker.

   Loads pre-extracted glyph images (single file or directory batch),
   converts each into a wsign, translates every lsign with the configured
   translators and lets the reviewer correct the proposals before saving
   curated corpus entries identical to the automatic ones (ADR-0002).

    Screen layout follows the mockup (specs/translator-checker/
    GUI-screen.png): top panel with the large 'gliph image' display frame,
    middle 'lsigns' table with 7 columns (Lsign image, start, freq, diff,
    knn, select, save) and a menu bar with a File menu (open image / open
    directory / quit) plus direct Save, Previous, Next and Delete buttons."
  (:require
   [basilisp.core :refer [format]]
   [basilisp.io :as bio]
   [basilisp.string :as str]
   [steno.converter :as cnv]
   [steno.imageprocessor :as img]
   [steno.translator :as tra]
   [steno.utils :as utl])
  (:import
   base64
   cv2
   pathlib
   [tempfile :as tf]
   [threading :as th]
   [tkinter :as tk]
   [matplotlib.figure :as mfig]
   [matplotlib.backends.backend_tkagg :as tkagg]
   [tkinter.filedialog :as fd]
   [tkinter.messagebox :as mb]
   [tkinter.ttk :as ttk]))

(def thumbnail-height 40)
(def image-suffixes #{"png" "jpg" "jpeg" "tif" "tiff"})
(def table-headers ["Lsign" "start" "freq" "diff" "knn" "select" "save"])

;; ---------------------------------------------------------------------------
;; Pure checker core
;; ---------------------------------------------------------------------------

(defn load-glyph
  "Load the glyph image at PATH and convert it into a wsign (nil if unreadable)."
  [path-str]
  (let [image (cv2/imread path-str cv2/IMREAD_GRAYSCALE)]
    (when-not (nil? image)
      (-> image
          img/process-image
          cnv/image-to-wsign))))

(defn build-rows
  "Translate every lsign of WSIGN and build one review row per lsign.

   Each row holds the lsign position, its rendered matrix, the first
   lineseq cell, the per translator candidate pairs, the combined best
   match proposal, the selectable letter (pre-filled with the best match)
   and the save flag."
  [ctx translators wsign]
  (map-indexed (fn [pos lsign]
                 (let [{:keys [letters text]} (tra/translate-lsign ctx translators lsign)]
                   {:pos pos
                    :lsign lsign
                    :matrix (utl/lineseq-to-matrix (:lineseq lsign))
                    :start (subvec (first (:lineseq lsign)) 0 2)
                    :results (zipmap translators letters)
                    :best text
                    :select text
                    :save? true}))
               wsign))

(defn format-chain
  "Format candidate PAIRS as a probability chain, e.g. \"t(0.91) l(0.75)\"."
  [pairs]
  (->> pairs
       (map #(format "%s(%.2f)" (first %) (second %)))
       (str/join " ")))

(defn format-results
  "Format every translator entry of RESULTS as a probability chain string."
  [results]
  (into {} (map (fn [[name pairs]] [name (format-chain pairs)]) results)))

(defn lsign-entry
  "Reduce LSIGN to the exact corpus entry fields (ADR-0002 contract)."
  [imagefile pos lsign]
  {:ltype (:ltype lsign)
   :lineseq (:lineseq lsign)
   :fileimage imagefile
   :row 0
   :column 0
   :pos pos})

(defn entry-filename
  "Corpus filename of the sign at POS of IMAGEFILE: <image>-<pos>.edn."
  [imagefile pos]
  (format "%s-%01d.edn" (utl/get-filename imagefile) pos))

(defn entry-path
  "Destination corpus file for the LETTER chosen for the sign at POS of IMAGEFILE."
  [corpus-dir letter imagefile pos]
  (bio/path (bio/path corpus-dir letter) (entry-filename imagefile pos)))

(defn savable-row?
  "True if ROW gets saved: save box checked and non-empty letter selection."
  [row]
  (boolean (and (:save? row) (seq (:select row)))))

(defn save-row!
  "Persist ROW as a corpus entry under CORPUS-DIR/<letter>/, creating parents
   on demand. The lsign lineseq is normalized to the axe origin before saving
   (cnv/normalize2-lsign). Saving twice the same position replaces the previous
   entry. Returns the destination path."
  [logger corpus-dir imagefile {:keys [pos select lsign]}]
  (let [outfile (entry-path corpus-dir select imagefile pos)
        lsign (cnv/normalize2-lsign lsign)]
    (.mkdir (.-parent outfile) ** :parents true :exist_ok true)
    (utl/save-edn outfile (lsign-entry imagefile pos lsign))
    (.info logger "Saved in %s" outfile)
    outfile))

(defn letters-list
  "Sorted list of existing corpus letter folders under CORPUS-DIR.
   Returns an empty vector when CORPUS-DIR does not exist yet."
  [corpus-dir]
  (let [dir (pathlib/Path corpus-dir)]
    (if (.exists dir)
      (->> (iterator-seq (.iterdir dir))
           (filter #(.is_dir %))
           (map #(.-name %))
           sort
           vec)
      [])))

(defn image-file?
  "True if P is an existing file carrying an accepted image suffix."
  [p]
  (let [ext (str/lower-case (.-suffix p))
        ext (if (str/starts-with? ext ".") (subs ext 1) ext)]
    (and (.is_file p)
         (contains? image-suffixes ext))))

(defn expand-input
  "Expand INPUT into a sorted vector of glyph image paths: the file itself
   or every image file of a directory (review queue in name order)."
  [input]
  (let [p (pathlib/Path input)]
    (cond
      (.is_file p) [input]
      (.is_dir p) (->> (iterator-seq (.iterdir p))
                       (filter image-file?)
                       (map str)
                       sort
                       vec)
      :else [])))

(defn loadable-file?
  "True if the glyph image at PATH converts to at least one sign
   (imread failure and empty wsign both count as unreadable)."
  [path-str]
  (boolean (seq (load-glyph path-str))))

(defn next-available?
  "True when the queue FILES has a glyph after index IDX."
  [files idx]
  (and (seq files) (< idx (dec (count files)))))

(defn prev-available?
  "True when the queue FILES has a glyph before index IDX."
  [_files idx]
  (pos? idx))

(defn busy-guard?
  "True when the UI state snapshot carries an active :busy? flag."
  [state]
  (boolean (:busy? state)))

(defn load-position-data
  "Compute the data shown for the glyph at IDX of FILES: convert the glyph
   (or skip forward past unreadable entries, one per position) and build the
   review rows. Returns {:imagefile :idx :rows :skipped} where ROWS is the
   build-rows result for the chosen glyph, IDX its queue position, and
   SKIPPED the file names passed over (empty when no skip). IMAGEFILE is nil
   and ROWS empty when the tail is exhausted. Pure — no Tk types."
  [ctx translators files idx]
  (loop [i idx skipped []]
    (if (< i (count files))
      (let [file (nth files i)
            wsign (try (load-glyph file)
                       (catch Exception _ nil))]
        (if (seq wsign)
          {:imagefile file
           :idx i
           :rows (vec (build-rows ctx translators wsign))
           :skipped skipped}
          (recur (inc i) (conj skipped file))))
      {:imagefile nil :idx idx :rows [] :skipped skipped})))

;; ---------------------------------------------------------------------------
;; Image helpers
;; ---------------------------------------------------------------------------

(defn- matrix-to-png-bytes
  "Encode a matrix as PNG bytes (used by the thumbnail / glyph rendering)."
  [mat]
  (.tobytes (second (cv2/imencode ".png" mat))))

;; ---------------------------------------------------------------------------
;; tkinter UI layer (thin, private defs)
;; ---------------------------------------------------------------------------

(defn- scale-height
  "Resize MAT proportionally to HEIGHT pixels."
  [mat height]
  (let [[h w] (.-shape mat)]
    (if (= h height)
      mat
      (cv2/resize mat
                  (python/tuple [(int (* w (/ height h))) height])
                  ** :interpolation cv2/INTER_NEAREST))))

(defn- matrix-photo
  "Create a Tk PhotoImage from MAT scaled to HEIGHT pixels, keeping a
   reference in PHOTOS* so Tk does not garbage collect it. Falls back to a
   temporary PNG file if the direct base64 payload fails."
  [photos* key mat height]
  (let [photo (try
                (tk/PhotoImage ** :data (-> mat
                                            (scale-height height)
                                            matrix-to-png-bytes
                                            (base64/b64encode)
                                            (.decode "ascii")))
                (catch Exception _
                  (let [tmp (tf/NamedTemporaryFile ** :suffix ".png" :mode "wb" :delete false)]
                    (.write tmp (matrix-to-png-bytes (scale-height mat height)))
                    (.flush tmp)
                    (.close tmp)
                    (tk/PhotoImage ** :file (.-name tmp)))))]
    (swap! photos* assoc key photo)
    photo))

(defn- clear-frame!
  "Destroy every child of FRAME."
  [frame]
  (doseq [child (.winfo_children frame)]
    (.destroy child)))

(defn- current-file
  "The glyph image file at the current queue position (nil when exhausted)."
  [ui]
  (let [{:keys [files idx]} @(:state* ui)]
    (nth files idx nil)))

(defn- refresh-table!
  "Rebuild the 'lsigns' table for the current ROWS: one 7-column row per
   lsign (thumbnail, start, freq, diff, knn chains, select combobox, save
   box), the content columns separated by vertical rules."
  [ui rows]
  (let [{:keys [table photos* widgets*]} ui
        letters (letters-list (:corpus-dir ui))
        widgets (volatile! [])
        n-sections (count table-headers)]
    (clear-frame! table)
    (doseq [[col header] (map-indexed vector table-headers)]
      (doto (tk/Label table ** :text header  :padx 5  :pady 5)
        (.grid ** :row 0  :column (* col 2)  :sticky "ew")))
    (doseq [col (range (dec n-sections))]
      (doto (ttk/Separator table ** :orient "vertical")
        (.grid ** :row 0  :column (inc (* col 2))  :rowspan (inc (count rows))  :sticky "ns")))
    (doseq [row rows]
      (let [r (inc (:pos row))
            key (keyword (str "row-" (:pos row)))
            thumb (tk/Label table ** :image (matrix-photo photos* key (:matrix row) thumbnail-height))
            start-label (tk/Label table ** :text (str (:start row))  :anchor "w"  :padx 5)
            results (format-results (:results row))
            freq-label (tk/Label table ** :text (get results "freq")  :anchor "w"  :padx 5)
            diff-label (tk/Label table ** :text (get results "diff")  :anchor "w"  :padx 5)
            knn-label (tk/Label table ** :text (get results "knn")  :anchor "w"  :padx 5)
            sel-var (tk/StringVar ** :value (:select row))
            save-var (tk/BooleanVar ** :value (boolean (:save? row)))
            combo (ttk/Combobox table ** :textvariable sel-var
                                :values (python/tuple letters)  :width 8)
            check (tk/Checkbutton table ** :variable save-var)]
        (.grid thumb ** :row r  :column 0)
        (.grid start-label ** :row r  :column 2  :sticky "ew")
        (.grid freq-label ** :row r  :column 4  :sticky "ew")
        (.grid diff-label ** :row r  :column 6  :sticky "ew")
        (.grid knn-label ** :row r  :column 8  :sticky "ew")
        (.grid combo ** :row r  :column 10  :padx 5)
        (.grid check ** :row r  :column 12  :padx 5)
        (vswap! widgets conj {:sel-var sel-var :save-var save-var :row row})))
    (doseq [col [4 6 8]]
      (.columnconfigure table col ** :weight 1))
    (reset! widgets* @widgets)))

(defn- refresh-glyph!
  "Show the current glyph in the top 'gliph image' frame side by side:
    the original image on the left and the processed image on the right,
    both with x/y axes."
  [ui imagefile]
  (let [orig-image (cv2/imread imagefile cv2/IMREAD_GRAYSCALE)]
    (when-not (nil? orig-image)
      (let [proc-image (img/process-image orig-image)
            orig-ax (:glyph-orig-ax ui)
            proc-ax (:glyph-proc-ax ui)]
        (.clear orig-ax)
        (.imshow orig-ax orig-image ** :cmap "gray")
        (.set_title orig-ax "original")
        (.set_xlabel orig-ax "x")
        (.set_ylabel orig-ax "y")
        (.axis orig-ax "on")
        (.clear proc-ax)
        (.imshow proc-ax proc-image ** :cmap "gray")
        (.set_title proc-ax imagefile)
        (.set_xlabel proc-ax "x")
        (.set_ylabel proc-ax "y")
        (.axis proc-ax "on")
        (.draw (:glyph-canvas ui))))))

(defn- clear-screen!
  "Empty the screen when no glyph is available."
  [ui]
  (clear-frame! (:table ui))
  (reset! (:widgets* ui) [])
  (reset! (:photos* ui) {})
  (let [orig-ax (:glyph-orig-ax ui)
        proc-ax (:glyph-proc-ax ui)]
    (.clear orig-ax)
    (.axis orig-ax "off")
    (.clear proc-ax)
    (.axis proc-ax "off")
    (.draw (:glyph-canvas ui))))

(declare set-actions-enabled!
         set-status!)

(defn- worker-load!
  "Worker body: compute the glyph data for IDX of FILES and post it into
   RESULT* (atom), signalling DONE?. Pure — never touches Tk. A throw inside
   the pipeline is treated as an unreadable glyph (empty result) so the main
   loop always receives a commit."
  [ctx translators files idx result* done?]
  (reset! result* (try (load-position-data ctx translators files idx)
                       (catch Exception _ {:imagefile nil :idx idx :rows [] :skipped []})))
  (reset! done? true))

(defn- commit-load!
  "Main-thread apply of a finished worker RESULT: clear the busy state and
   refresh the screen. Discards the result when the queue moved on since the
   load started (stale-commit guard)."
  [ui {:keys [token result]}]
  (let [{:keys [files idx busy?]} @(:state* ui)
        [start-files start-idx] token]
    (when (and busy? (= start-files files) (= start-idx idx))
      (set-actions-enabled! ui true)
      (.stop (:progress ui))
      (let [{:keys [imagefile rows skipped] :as loaded} result]
        (set-status! ui (if (seq skipped)
                          (format "Skipped unreadable glyph %s" (first skipped))
                          "Ready"))
        (swap! (:state* ui) assoc :busy? false)
        (if imagefile
          (do (swap! (:state* ui) assoc :idx (:idx loaded) :rows rows)
              (refresh-table! ui rows)
              (refresh-glyph! ui imagefile))
          (do (swap! (:state* ui) assoc :rows [])
              (clear-screen! ui)
              (when (seq files)
                (mb/showinfo ** :parent (:root ui)
                             :title "End of queue"
                             :message "No more glyphs to review"))))))))

(defn- load-position!
  "Asynchronously load the glyph at the current queue index: process it on a
   worker thread, block input while busy and commit on the main loop."
  [ui]
  (let [{:keys [files idx]} @(:state* ui)]
    (swap! (:state* ui) assoc :busy? true)
    (set-actions-enabled! ui false)
    (.start (:progress ui))
    (set-status! ui (format "Processing %d/%d …" (inc idx) (count files)))
    (let [ctx (:ctx ui)
          translators (:translators ui)
          result* (atom nil)
          done? (atom false)
          token [files idx]
          thread (th/Thread ** :daemon true
                            :target (fn [] (worker-load! ctx translators files idx result* done?)))]
      (reset! (:worker* ui) thread)
      (.start thread)
      (letfn [(poll []
                (if @done?
                  (commit-load! ui {:token token :result @result*})
                  (.after (:root ui) 40 poll)))]
        (.after (:root ui) 40 poll)))))

(defn- open-input!
  "Replace the review queue with INPUT (image or directory) and load it
   (ignored while another glyph is still processing)."
  [ui input]
  (when-not (busy-guard? @(:state* ui))
    (reset! (:state* ui) {:files (vec (expand-input input)) :idx 0 :rows [] :busy? false})
    (load-position! ui)))

(defn- open-image!
  "Ask for a glyph image file and open it."
  [ui]
  (let [f (fd/askopenfilename ** :parent (:root ui)
                              :title "Open glyph image"
                              :filetypes [["images" "*.png *.jpg *.jpeg *.tif *.tiff"]
                                          ["all files" "*"]])]
    (when-not (str/blank? f)
      (open-input! ui f))))

(defn- open-dir!
  "Ask for a glyph image directory and open it as a batch."
  [ui]
  (let [d (fd/askdirectory ** :parent (:root ui)  :title "Open glyph directory")]
    (when-not (str/blank? d)
      (open-input! ui d))))

(defn- prev-glyph!
  "Move back one glyph in the review queue (boundary-notifying)."
  [ui]
  (let [{:keys [files idx busy?]} @(:state* ui)]
    (cond
      busy? nil
      (prev-available? files idx) (do (swap! (:state* ui) update :idx dec)
                                      (load-position! ui))
      :else (mb/showinfo ** :parent (:root ui)
                         :title "Previous glyph"
                         :message "This is the first glyph"))))

(defn- next-glyph!
  "Move forward one glyph in the review queue (boundary-notifying)."
  [ui]
  (let [{:keys [files idx busy?]} @(:state* ui)]
    (cond
      busy? nil
      (next-available? files idx) (do (swap! (:state* ui) update :idx inc)
                                      (load-position! ui))
      :else (mb/showinfo ** :parent (:root ui)
                         :title "Next glyph"
                         :message "No more glyphs to review"))))

(defn- delete-glyph!
  "Delete the glyph image file at the current queue position, remove it
   from the review queue and reload the screen (confirmation first)."
  [ui]
  (when-not (busy-guard? @(:state* ui))
    (let [{:keys [files idx]} @(:state* ui)
          file (nth files idx nil)]
      (when (and file (.exists (pathlib/Path file)))
        (when (mb/askyesno ** :parent (:root ui)
                           :title "Delete glyph"
                           :message (str "Delete " file "?"))
          (.unlink (pathlib/Path file))
          (let [new-files (vec (keep-indexed (fn [i f] (when (not= i idx) f)) files))
                new-idx (if (empty? new-files) 0 (min idx (dec (count new-files))))]
            (swap! (:state* ui) assoc :files new-files :idx new-idx :rows [])
            (load-position! ui)))))))

(defn- collect-row!
  "Merge the live widget values into ROW."
  [{:keys [sel-var save-var row]}]
  (assoc row :select (.get sel-var) :save? (.get save-var)))

(defn- save-checked!
  "SAVE: persist every checked row with a non-empty letter selection."
  [ui]
  (when-not (busy-guard? @(:state* ui))
    (let [savable (filter savable-row? (map collect-row! @(:widgets* ui)))
          saved-count (count savable)]
      (doseq [row savable]
        (save-row! (:logger ui) (:corpus-dir ui) (current-file ui) row))
      (mb/showinfo ** :parent (:root ui)
                   :title "Saved"
                   :message (format "Saved %d signs" saved-count))
      saved-count)))

(defn- quit-app!
  "QUIT: close the application."
  [ui]
  (let [root (:root ui)
        worker @(:worker* ui)]
    (when worker
      (try (.join worker 1.0)
           (catch Exception _ nil)))
    (.quit root)
    (.destroy root)))

(defn- set-actions-enabled!
  "Enable (ENABLED? true) or disable the menu items that mutate the review
   session while a glyph is processing."
  [ui enabled?]
  (let [state (if enabled? "normal" "disabled")]
    (doseq [idx [1 2 3 4]]
      (.entryconfigure @(:menubar* ui) idx ** :state state))
    (doseq [idx [0 1]]
      (.entryconfigure @(:file-menu* ui) idx ** :state state))))

(defn- build-menu!
  "Menu bar: File menu (open image / open directory / quit) plus direct
   Save, Previous and Next command buttons. Records the menubar in UI for
   busy-state disabling."
  [root ui]
  (let [menubar (tk/Menu root)
        file-menu (tk/Menu menubar ** :tearoff 0)]
    (doto file-menu
      (.add_command ** :label "Open image..."
                    :accelerator "Ctrl-O"
                    :command (fn [] (open-image! ui)))
      (.add_command ** :label "Open directory..."
                    :command (fn [] (open-dir! ui)))
      (.add_separator)
      (.add_command ** :label "Quit"
                    :accelerator "Ctrl-Q"
                    :command (fn [] (quit-app! ui))))
    (.add_cascade menubar ** :label "File"  :menu file-menu)
    (.add_command menubar ** :label "Save"
                  :accelerator "Ctrl-S"
                  :command (fn [] (save-checked! ui)))
    (.add_command menubar ** :label "Previous"
                  :accelerator "Ctrl-Left"
                  :command (fn [] (prev-glyph! ui)))
    (.add_command menubar ** :label "Next"
                  :accelerator "Ctrl-Right"
                  :command (fn [] (next-glyph! ui)))
    (.add_command menubar ** :label "Delete"
                  :accelerator "Ctrl-D"
                  :command (fn [] (delete-glyph! ui)))
    (.config root ** :menu menubar)
    (reset! (:menubar* ui) menubar)
    (reset! (:file-menu* ui) file-menu)
    ui))

(defn- build-top-panel!
  "Top panel: the large central image display frame labelled 'gliph image',
    rendered through a matplotlib canvas showing two x/y axes side by side:
    the original image on the left and the processed image on the right."
  [root photos*]
  (let [panel (tk/LabelFrame root ** :text "gliph image"  :padx 10  :pady 10)
        fig (mfig/Figure ** :figsize (python/tuple [10 5]))
        canvas (tkagg/FigureCanvasTkAgg fig panel)
        orig-ax (.add_subplot fig 1 2 1)
        proc-ax (.add_subplot fig 1 2 2)]
    (.pack (.get_tk_widget canvas) ** :padx 10  :pady 10)
    {:panel panel
     :glyph-fig fig
     :glyph-orig-ax orig-ax
     :glyph-proc-ax proc-ax
     :glyph-canvas canvas
     :photos* photos*}))

(defn- build-status-bar!
  "Bottom panel: an indeterminate progress bar (start/stop around glyph
   processing) and a status label alongside it."
  [root]
  (let [panel (tk/LabelFrame root ** :text "status"  :padx 10  :pady 5)
        progress (ttk/Progressbar panel ** :mode "indeterminate"  :length 200)
        label (tk/Label panel ** :text "Ready"  :anchor "w")]
    (.pack label ** :side "left"  :fill "x"  :expand true)
    (.pack progress ** :side "right"  :padx 8)
    {:status-panel panel
     :progress progress
     :status-label label}))

(defn- set-status!
  "Set the status label text."
  [ui text]
  (.configure (:status-label ui) ** :text text))

(defn- build-table-panel!
  "Middle panel: the 'lsigns' table frame."
  [root]
  (tk/LabelFrame root ** :text "lsigns"  :padx 10  :pady 10))

;; module entry points

(defn make-ui
  "Assemble the UI context map shared by all callbacks."
  [root ctx translators corpus-dir inputs]
  (merge (build-top-panel! root (atom {}))
         (build-status-bar! root)
         {:root root
          :state* (atom {:files (vec inputs) :idx 0 :rows [] :busy? false})
          :widgets* (atom {})
          :worker* (atom nil)
          :menubar* (atom nil)
          :file-menu* (atom nil)
          :ctx ctx
          :translators translators
          :corpus-dir corpus-dir}))

(defn run-checker!
  "Run the interactive checker application.

   CTX is the translation context built once by the check action;
   TRANSLATORS the selected translator names; INPUTS the initial review
   queue (expanded glyph image paths); CORPUS-DIR the curated corpus
   output directory."
  [{:keys [logger] :as ctx} translators inputs corpus-dir]
  (let [root (tk/Tk)
        {:keys [panel status-panel] :as ui*} (make-ui root ctx translators corpus-dir inputs)
        table (build-table-panel! root)
        ui (assoc ui* :table table :logger logger)]
    (doto root
      (.title "translator checker")
      (.geometry "1000x900"))
    (build-menu! root ui)
    (.pack panel ** :side "top"  :fill "x")
    (.pack table ** :side "top"  :fill "both"  :expand true)
    (.pack status-panel ** :side "bottom"  :fill "x")
    (.bind root "<Control-o>" (fn [_] (open-image! ui)))
    (.bind root "<Control-s>" (fn [_] (save-checked! ui)))
    (.bind root "<Control-Left>" (fn [_] (prev-glyph! ui)))
    (.bind root "<Control-Right>" (fn [_] (next-glyph! ui)))
    (.bind root "<Control-d>" (fn [_] (delete-glyph! ui)))
    (.bind root "<Control-q>" (fn [_] (quit-app! ui)))
    (when (seq inputs)
      (load-position! ui))
    (.mainloop root)))

(comment

  (require '[steno.translators.diff]
           '[steno.translators.freq]
           '[steno.translators.knn])

  (def config {"freq_references" "resources/freq-references.edn"
               "diff_references" "resources/diff-references.edn"
               "knn_references" "resources/knn-references.edn"
               "knn_k" 3})
  (def translators ["freq" "diff" "knn"])
  (def ctx (tra/prepare-translations config translators))
  (def corpus-dir "resources/corpus")

  ;; 1.2 glyph loading: a real extracted glyph converts into a wsign
  (def glyph-file "tmp/yoga1_12/yoga1_12-01-11.png")

  (def wsign (load-glyph glyph-file))
  (count wsign)
  ;; => >= 1
  (mapv (juxt :ltype count) (map :lineseq wsign))
  ;; => non-empty vector of [ltype lineseq-size] pairs

  (nil? (load-glyph "does/not/exist.png"))
  ;; => true

  ;; 1.3 row-model builder
  (def rows (vec (build-rows ctx translators wsign)))
  (count rows)
  ;; => (count wsign)

  (def row (first rows))
  (:pos row)
  ;; => 0
  (keys (:results row))
  ;; => ("freq" "diff" "knn") in some order
  (every? vector? (vals (:results row)))
  ;; => true, each translator contributes a vector of [letter match] pairs
  (= (:select row) (:best row))
  ;; => true, selector pre-filled with the best match
  (:start row)
  ;; => [X Y] first lineseq cell cut to row/column only, e.g. [0 0]
  (count (:start row))
  ;; => 2
  (:save? row)
  ;; => true

  ;; 1.4 result formatter
  (format-chain [["t" 0.91] ["l" 0.75]])
  ;; => "t(0.91) l(0.75)"
  (format-chain [])
  ;; => ""
  (format-chain [["ge" 0.5]])
  ;; => "ge(0.50)"
  (format-results {"freq" [["t" 0.91]] "diff" [["t" 1.0]]})
  ;; => {"freq" "t(0.91)", "diff" "t(1.00)"}

  ;; 1.5 corpus save data (ADR-0002): annotation stripping
  (lsign-entry "yoga1_12-01-11.png" 2
               {:ltype 1 :lineseq [[0 0 128] [0 1 136]] :numseq [136] :letters [[["t" 1.0]]]})
  ;; => {:ltype 1, :lineseq [[0 0 128] [0 1 136]],
  ;;     :fileimage "yoga1_12-01-11.png", :row 0, :column 0, :pos 2}

  (entry-filename "yoga1_12-01-11.png" 2)
  ;; => "yoga1_12-01-11-00-00-2.edn"

  (str (entry-path "resources/corpus" "t" "yoga1_12-01-11.png" 2))
  ;; => "resources/corpus/t/yoga1_12-01-11-00-00-2.edn"

  ;; saving creates the letter folder and replaces on re-save
  (import logging)
  (def tmp-corpus "/tmp/opencode/checker-corpus")
  (def logger (logging/getLogger "checker-tests"))

  (save-row! logger
             tmp-corpus "yoga1_12-01-11.png"
             {:pos 2 :select "ţ" :lsign {:ltype 1 :lineseq [[0 0 128]]}})
  (letters-list tmp-corpus)
  ;; => ["ţ"]
  (utl/load-edn (str (entry-path tmp-corpus "ţ" "yoga1_12-01-11.png" 2)))
  ;; => {:ltype 1, :lineseq [[0 0 128]], :fileimage "yoga1_12-01-11.png",
  ;;     :row 0, :column 0, :pos 2}
  (save-row! logger
             tmp-corpus "yoga1_12-01-11.png"
             {:pos 2 :select "ţ" :lsign {:ltype 0 :lineseq [[5 5 128]]}})
  (utl/load-edn (str (entry-path tmp-corpus "ţ" "yoga1_12-01-11.png" 2)))
  ;; => replaced entry: {:ltype 0, :lineseq [[0 0 128]], :pos 2} —
  ;;    lineseq renormalized to the axe origin, same single file, not duplicated

  ;; 1.6 letters list against the project corpus
  (letters-list corpus-dir)
  ;; => sorted vector of existing letter folders

  ;; input expansion
  (expand-input "resources/config.yml")
  ;; => ["resources/config.yml"]
  (expand-input "does/not/exist")
  ;; => []
  (count (expand-input "tmp/yoga1_12"))
  ;; => number of png images in the batch

  (image-file? (pathlib/Path "resources/config.yml"))
  ;; => false
  (image-file? (pathlib/Path "tmp/yoga1_12/yoga1_12-01-11.png"))
  ;; => true

  ;; 1.7 skip filter
  (savable-row? {:save? true :select "t"})
  ;; => true
  (savable-row? {:save? false :select "t"})
  ;; => false, unchecked box skips the row
  (savable-row? {:save? true :select ""})
  ;; => false, empty selection skips the row

  ;;
  )
