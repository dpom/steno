(ns steno.spec
  "Defines the entities of this application (documentation only)")

(def LOOP 0)
(def LINE 1)

(def LTYPE [:enum LOOP LINE])

(def X nat-int?)
(def Y nat-int?)

(def CNUM [:and nat-int? #(< % 256)])

(def CNUMSEQ [:sequential CNUM])

(def CELL [:tuple X Y CNUM])

(def LSEQ [:sequential CELL])

(def MATCH [:and float? #(< 0 %) #(> 1 %)])

(def LETTER
  [:touple
   [:string {:min 1 :max 2}]
   MATCH])

(def LETTERS [:sequential LETTER])

(def LSIGN
  [:map
   [:ltype LTYPE]
   [:lineseq LSEQ]
   [:letters [:sequential LETTERS]]
   [:text string?]])

(def WSIGN [:sequential LSIGN])

(def FREQ [:map-of :int :int])

(def FREQ-REFERENCE
  [:map
   [:letter string?]
   [:min-len nat-int?]
   [:max-len nat-int?]
   [:reference FREQ]
   [:min-match MATCH]])

(def DIFF-REFERENCE
  [:map
   [:letter string?]
   [:min-len nat-int?]
   [:max-len nat-int?]
   [:reference CNUMSEQ]
   [:max-bits nat-int?]
   [:min-match MATCH]])

(def REFERENCE [:or FREQ-REFERENCE DIFF-REFERENCE])

(def REFERENCES
  [:map
   [:type-0 [:sequential REFERENCE]]
   [:type-1 [:sequential REFERENCE]]
   [:min-refseq nat-int?]])

(def CORPUS-ITEM
  [:map
   [:fileimage string?]
   [:row nat-int?]
   [:column nat-int?]
   [:pos nat-int?]
   [:ltype LTYPE]
   [:lineseq LSEQ]
   [:width nat-int?]
   [:height nat-int?]])

(def all-directions
  "The eight 8-connected directions (orthogonals + diagonals). Real Duployer
    skeletons are 8-connected, so the graph must use all eight to keep true
    junctions intact."
  [[0  1]    ; E
   [1  0]    ; S
   [0 -1]    ; V
   [-1  0]   ; N
   [1  1]    ; SE
   [1 -1]    ; SV
   [-1 -1]   ; NV
   [-1  1]]) ; NE

(def pos
  "Direction position in the cell number"
  [2r10000000 ; E
   2r01000000 ; S
   2r00100000 ; V
   2r00010000 ; N
   2r00001000 ; SE
   2r00000100  ; SV
   2r00000010  ; N
   2r00000001] ; NE
  )

(def dummy-cell [-1 -1])
