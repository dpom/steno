(ns steno.imageprocessor
  "Prepare the page image"
  (:require
   [steno.spec :as spec]
   [steno.utils :as utl])
  (:import
   cv2
   math
   [numpy :as np]
   [skimage.morphology :as skim]
   [skimage.util :as skiu]))

(def gap-distance
  "Max pixel distance from an endpoint within which a bridge may be drawn."
  10)

(defn process-image1
  "Process the IMAGE with a threshold + opening strategy to obtain a clear
   1 pixel thick stenogram. Cleaner per stroke, but may drop thin strokes."
  [image]
  (let [kernel (cv2/getStructuringElement cv2/MORPH_ELLIPSE [3 3])]
    (-> (second (cv2/threshold image 127 255 cv2/THRESH_BINARY_INV))
        (cv2/morphologyEx cv2/MORPH_OPEN kernel)
        (np/floor_divide  255)
        (skim/skeletonize)
        (skiu/img_as_ubyte))))

(defn process-image2
  "Process the IMAGE with an invert + blur strategy to obtain a clear 1 pixel
   thick stenogram. More complete, but blur may merge nearby strokes."
  [image]
  (-> image
      (cv2/bitwise_not)
      (cv2/blur [5 5])
      (skim/skeletonize)
      (skiu/img_as_ubyte)))

(defn skeleton-score
  "Lower means a cleaner skeleton. Penalise thick (merged) strokes, which
   survive a 3x3 erosion, and an excessive number of disconnected fragments."
  [skel]
  (let [u (skiu/img_as_ubyte skel)
        kernel (cv2/getStructuringElement cv2/MORPH_RECT [3 3])
        thick (cv2/countNonZero (cv2/erode u kernel))
        [n _] (cv2/connectedComponents u nil 8)]
    (+ (int n) (* 2 (int thick)))))

(defn process-image-best
  "Pick, per glyph, the better of process-image1 and process-image2 using a
   skeleton-quality score (fewer thick/merged strokes and fewer fragments
   wins). Returns the chosen 1-pixel skeleton."
  [image]
  (let [p1 (utl/bin-u8 (process-image1 image))
        p2 (utl/bin-u8 (process-image2 image))
        sc1 (skeleton-score p1)
        sc2 (skeleton-score p2)]
    (cond
      (< sc1 sc2) p1
      (< sc1 sc2) p2
      :else (if (<= (count (utl/endpoint-coords p1)) (count (utl/endpoint-coords p2)))
              p1
              p2))))

(defn repair-skeleton
  "Bridge small gaps in a 1px skeleton IMAGE by connecting nearby dangling endpoints."
  ([image] (repair-skeleton image gap-distance))
  ([image max-gap]
   (let [eps (utl/endpoint-coords image)
         result (np/copy image)]
     (when (> (count eps) 2)
       (doseq [p1 eps
               p2 eps]
         (when (and (not= p1 p2) (< (math/dist p1 p2) max-gap))
           (let [[y1 x1] p1
                 [y2 x2] p2]
             (cv2/line result [x1 y1] [x2 y2] 255 1)))))
     result)))

(defn process-image
  "Process the IMAGE into a clear 1 pixel thick stenogram by auto-selecting
   the better of the two skeletonization strategies (ADR-0001), then repairing
   over-thinning gaps so a single stroke stays continuous."
  [image]
  (repair-skeleton (process-image-best image)))

(comment

  (require
   '[steno.show :as show])

  (def fileimage "test/resources/rol.png")

  (def image (cv2/imread fileimage cv2/IMREAD_GRAYSCALE))

  (show/show-image image)

  (def img1 (process-image1 image))

  (def img2 (process-image2 image))

  (show/show-two-images [img1 img2])

  (skeleton-score img1)
  ;; => 4

  (utl/endpoint-coords img1)
  ;; => ([1 129] [15 140] [15 191] [23 142] [92 22] [95 9] [95 16] [99 6] [102 3])

  (def img1b (repair-skeleton img1))

  (show/show-two-images [img1 img1b])

  (skeleton-score img2)
  ;; => 4

  (utl/endpoint-coords img2)
  ;; => ([7 196] [87 182] [88 174] [89 180] [90 173] [101 4])

  (def img2b (repair-skeleton img2))

  (show/show-two-images [img2 img2b])

  (utl/endpoint-coords img2b)
  ;; => ([7 196] [101 4])

  (def best (process-image-best image))

  (show/show-two-images [image best])

  ;;
  )
